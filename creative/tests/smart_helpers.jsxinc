var ZyCreative=(function(){
 var s=stringIDToTypeID,c=charIDToTypeID;
 function select(id){var r=new ActionReference();r.putIdentifier(c('Lyr '),id);var d=new ActionDescriptor();d.putReference(c('null'),r);d.putBoolean(c('MkVs'),false);executeAction(c('slct'),d,DialogModes.NO);}
 function layer(id){var r=new ActionReference();r.putIdentifier(c('Lyr '),id);return executeActionGet(r);}
 function filters(id){return layer(id).getObjectValue(s('smartObject')).getList(s('filterFX'));}
 function state(id,index){var fx=filters(id).getObjectValue(index-1);return {event:fx.getObjectType(s('filter')),parameters:fx.getObjectValue(s('filter'))};}
 function set(id,index,event,p){var r=new ActionReference();r.putIndex(s('filterFX'),index);r.putIdentifier(c('Lyr '),id);var d=new ActionDescriptor(),fx=new ActionDescriptor();d.putReference(c('null'),r);fx.putObject(s('filter'),event,p);d.putObject(s('filterFX'),s('filterFX'),fx);return executeAction(c('setd'),d,DialogModes.NO);}
 function params(kind,w,h,variant){
  var p=new ActionDescriptor(),q=variant?1:0;p.putInteger(c('ZcSv'),1);p.putInteger(c('ZcKd'),kind);
  var keys=['ZcCX','ZcCY','ZcAm','ZcSz','ZcCo','ZcEv','ZcCy','ZcSe','ZcHX','ZcVY','ZcMx','ZcDr','ZcWi','ZcIn','ZcEI','ZcTh','ZcRo'];
  var values=[w*.5+q*7,h*(kind===1?.25:.5)+q*4,13+q*16,kind===2?27+q*15:37+q*24,2,37.5+q*64.5,2,23+q*68,85,117,75,14-q*36,53+q*58,83,70-q*51,3+q*5,13-q*32];
  for(var i=0;i<keys.length;i++)p.putDouble(c(keys[i]),values[i]);
  keys=['ZcTy','ZcPi','ZcEd','ZcSh','ZcRe','ZcMi','ZcQu','ZcCE','ZcFC'];values=[q?7:0,q?1:8,1,q?2:0,q?1:0,q?8:4,1,1,q];for(i=0;i<keys.length;i++)p.putInteger(c(keys[i]),values[i]);
  p.putDouble(c('ZcLR'),q?.9:.4);p.putDouble(c('ZcLG'),q?.3:1);p.putDouble(c('ZcLB'),q?.7:.25);return p;
 }
 function snapshot(id){var result=[];for(var i=1;i<=filters(id).count;i++){var x=state(id,i),p=x.parameters,r={event:typeIDToCharID(x.event)};for(var k=0;k<p.count;k++){var key=p.getKey(k),name=typeIDToCharID(key),type=p.getType(key);r[name]=type===DescValueType.INTEGERTYPE?p.getInteger(key):p.getDouble(key);}result.push(r);}return result;}
 return {select:select,layer:layer,filters:filters,state:state,set:set,params:params,snapshot:snapshot};
})();
